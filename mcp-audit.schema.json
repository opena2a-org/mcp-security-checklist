{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/opena2a-org/mcp-security-checklist/main/mcp-audit.schema.json",
  "title": "MCP audit configuration",
  "description": "Shape of mcp-audit.json, the reference configuration that enumerates the checks a thorough MCP audit should automate. No tool in this repository reads the configuration; the schema lets an editor or validator catch a misspelled key or a wrong value type in a copy of it.",
  "type": "object",
  "required": ["version", "audit"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "description": "Location of this schema, for editors that validate the file.",
      "type": "string",
      "minLength": 1
    },
    "version": {
      "description": "Version of the configuration format, as MAJOR.MINOR.PATCH.",
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "audit": {
      "type": "object",
      "required": ["target", "checks"],
      "additionalProperties": false,
      "properties": {
        "target": {
          "description": "The MCP server under audit. The checks cover a server reached over HTTP; the configuration has no fields for a stdio server.",
          "type": "object",
          "required": ["url"],
          "additionalProperties": false,
          "properties": {
            "url": {
              "description": "Base URL of the server.",
              "type": "string",
              "format": "uri",
              "pattern": "^https?://"
            },
            "protocolVersion": {
              "description": "MCP revision under audit. MCP names each revision by its date, YYYY-MM-DD.",
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            "transport": {
              "description": "streamable-http, or sse for the earlier HTTP with Server-Sent Events transport.",
              "enum": ["streamable-http", "sse"]
            }
          }
        },
        "checks": {
          "description": "One group per audit area. Each group present must say whether it is enabled.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "transport": {
              "type": "object",
              "required": ["enabled"],
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean" },
                "requireTls13": { "type": "boolean" },
                "requireHsts": { "type": "boolean" },
                "certificatePinning": { "type": "boolean" },
                "checkCertificateExpiry": { "type": "boolean" },
                "minimumCertValidityDays": {
                  "description": "Fewest days a certificate may have left before it is reported.",
                  "$ref": "#/$defs/positiveInteger"
                }
              }
            },
            "authentication": {
              "type": "object",
              "required": ["enabled"],
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean" },
                "requireTokenAuth": { "type": "boolean" },
                "maxTokenLifetimeSeconds": { "$ref": "#/$defs/positiveInteger" },
                "checkOAuthConfig": { "type": "boolean" },
                "requireMtlsForServerToServer": { "type": "boolean" }
              }
            },
            "inputValidation": {
              "type": "object",
              "required": ["enabled"],
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean" },
                "requireJsonSchemaValidation": { "type": "boolean" },
                "testInjectionPatterns": { "type": "boolean" },
                "injectionPatternSources": {
                  "description": "Where injection test patterns come from: built-in, or a URL.",
                  "type": "array",
                  "items": { "$ref": "#/$defs/nonEmptyString" }
                },
                "maxStringLength": { "$ref": "#/$defs/positiveInteger" },
                "allowedFilePathPrefixes": {
                  "type": "array",
                  "items": { "$ref": "#/$defs/nonEmptyString" }
                },
                "urlAllowlist": {
                  "type": "array",
                  "items": { "$ref": "#/$defs/nonEmptyString" }
                }
              }
            },
            "sandboxing": {
              "type": "object",
              "required": ["enabled"],
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean" },
                "checkContainerIsolation": { "type": "boolean" },
                "checkFilesystemRestrictions": { "type": "boolean" },
                "checkNetworkRestrictions": { "type": "boolean" },
                "checkResourceLimits": { "type": "boolean" },
                "maxExecutionTimeMs": { "$ref": "#/$defs/positiveInteger" },
                "maxMemoryMb": { "$ref": "#/$defs/positiveInteger" }
              }
            },
            "credentials": {
              "type": "object",
              "required": ["enabled"],
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean" },
                "scanConfigForSecrets": { "type": "boolean" },
                "checkEnvVarUsage": { "type": "boolean" },
                "checkCredentialRotation": { "type": "boolean" },
                "secretPatterns": {
                  "description": "Regular expressions, compiled as written with no flags, that match a credential stored in an MCP configuration file.",
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string", "minLength": 1, "format": "regex" }
                }
              }
            },
            "promptInjection": {
              "type": "object",
              "required": ["enabled"],
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean" },
                "scanToolDescriptions": { "type": "boolean" },
                "testIndirectInjection": { "type": "boolean" },
                "checkOutputSanitization": { "type": "boolean" }
              }
            },
            "logging": {
              "type": "object",
              "required": ["enabled"],
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean" },
                "checkAuditLogging": { "type": "boolean" },
                "checkSensitiveDataRedaction": { "type": "boolean" },
                "checkLogRetention": { "type": "boolean" },
                "requiredLogFields": {
                  "description": "Fields every audit log entry must carry.",
                  "type": "array",
                  "uniqueItems": true,
                  "items": { "$ref": "#/$defs/nonEmptyString" }
                }
              }
            },
            "network": {
              "type": "object",
              "required": ["enabled"],
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean" },
                "checkPublicExposure": { "type": "boolean" },
                "checkRateLimiting": { "type": "boolean" },
                "checkCorsConfig": { "type": "boolean" },
                "checkDnsRebinding": { "type": "boolean" },
                "maxRequestsPerMinute": { "$ref": "#/$defs/positiveInteger" }
              }
            },
            "supplyChain": {
              "type": "object",
              "required": ["enabled"],
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean" },
                "checkPinnedDependencies": { "type": "boolean" },
                "checkDependencyAudit": { "type": "boolean" },
                "scanContainerImages": { "type": "boolean" },
                "requireSbom": { "type": "boolean" },
                "checkDependencyUpdateAutomation": { "type": "boolean" }
              }
            },
            "incidentResponse": {
              "type": "object",
              "required": ["enabled"],
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean" },
                "checkToolKillSwitch": { "type": "boolean" },
                "checkServerKillSwitch": { "type": "boolean" },
                "checkCredentialRevocation": { "type": "boolean" }
              }
            }
          }
        },
        "reporting": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "format": {
              "description": "Report format. The reference configuration writes SARIF.",
              "type": "string",
              "minLength": 1
            },
            "outputFile": { "$ref": "#/$defs/nonEmptyString" },
            "severityThreshold": {
              "description": "Lowest severity included in the report.",
              "enum": ["info", "low", "medium", "high", "critical"]
            },
            "includeRemediation": { "type": "boolean" },
            "remediationResources": {
              "description": "Links attached to findings as remediation guidance, by topic.",
              "type": "object",
              "additionalProperties": { "type": "string", "format": "uri" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "positiveInteger": { "type": "integer", "minimum": 1 },
    "nonEmptyString": { "type": "string", "minLength": 1 }
  }
}
